# Django
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kech_delivery

# Redis (cache/broker)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Django Channels
CHANNEL_LAYERS_BACKEND=redis
CHANNEL_LAYERS_REDIS_URL=${REDIS_URL}

# JWT/Auth (tune later)
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Google Maps
GOOGLE_MAPS_API_KEY=change-me

# Chapa
CHAPA_SECRET_KEY=change-me
CHAPA_WEBHOOK_SECRET=change-me
CHAPA_CALLBACK_URL=http://localhost:3000/payment/callback
CHAPA_RETURN_URL=http://localhost:3000/payment/return

# Firebase (FCM + Storage) - service account fields
FIREBASE_PROJECT_ID=change-me
FIREBASE_CLIENT_EMAIL=change-me@change-me.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=change-me.appspot.com

# Notifications
FCM_ENABLED=1

# Storage
MEDIA_STORAGE_PROVIDER=firebase

# Operational defaults (seed into OperationalConfig)
DEFAULT_DRIVER_WAIT_MINUTES=30
DEFAULT_RESTAURANT_OPENING_TIME=08:30

# Pricing defaults (README: channel-based pricing)
PRICING_CUSTOMER_BASE_FEE=50
PRICING_CUSTOMER_PER_KM_RATE=25
PRICING_CUSTOMER_SERVICE_CHARGE=10

PRICING_SALES_BASE_FEE=50
PRICING_SALES_PER_KM_RATE=10

# Financial defaults (MVP snapshots)
DEFAULT_PLATFORM_FEE=10

