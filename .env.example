# --- Backend (`backend/.env`) — variable names match `config/settings.py` ---
DEBUG=1
SECRET_KEY=change-me-use-long-random-string-min-50-chars-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Omit for local SQLite (dev only).
# Host machine (Docker Compose often maps Postgres to localhost:5433 — see backend/docker-compose.yml):
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5433/kech_delivery
# Inside Compose only (service name `db` does NOT resolve on your PC):
# DATABASE_URL=postgres://USER:PASSWORD@db:5432/kech_delivery
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kech_delivery

# CORS: comma-separated origins (Next.js dashboard, mobile web).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOW_CREDENTIALS=1

# Behind Nginx / TLS terminator (sets SECURE_PROXY_SSL_HEADER, USE_X_FORWARDED_HOST)
BEHIND_REVERSE_PROXY=0

# Redis cache for DRF throttling (shared across Gunicorn workers). Docker Compose: redis://redis:6379/2
REDIS_CACHE_URL=redis://127.0.0.1:6379/2

# Production TLS (when DEBUG=0): redirect HTTP→HTTPS, secure cookies
# SECURE_SSL_REDIRECT=1

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# `/ready` Redis ping (set 0 in dev if Redis is not running)
READINESS_CHECK_REDIS=0

# JWT (names must match settings)
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=0
JWT_BLACKLIST_AFTER_ROTATION=0

# DRF throttling scopes (optional overrides)
# THROTTLE_AUTH_TOKEN=60/hour

# Auth audit logger (`kech.auth`)
# AUTH_LOG_LEVEL=INFO

# Django Channels (future)
CHANNEL_LAYERS_BACKEND=redis
CHANNEL_LAYERS_REDIS_URL=redis://localhost:6379/0

# --- Dashboard (`dashboard/.env.local`) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Integrations ---
GOOGLE_MAPS_API_KEY=change-me

# Chapa (backend `backend/.env`) — obtain keys from Chapa dashboard
CHAPA_PUBLIC_KEY=change-me
CHAPA_SECRET_KEY=change-me
CHAPA_WEBHOOK_SECRET=change-me
# Server-to-server callback (Chapa GET after payment) — must be publicly reachable in production
CHAPA_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/callback/chapa/
# Mobile deep link opened after checkout (not sent to Chapa API directly)
CHAPA_APP_RETURN_URL=kechdelivery://payment/return
# Optional https return URL for Chapa initialize (auto-derived from CALLBACK_URL if omitted):
# CHAPA_RETURN_HTTP_URL=https://your-ngrok-host/api/v1/payments/return/chapa/
# Legacy alias for deep link only:
CHAPA_RETURN_URL=kechdelivery://payment/return
CHAPA_CURRENCY=ETB
# Set 1 in local dev without keys (uses mock Chapa responses)
# CHAPA_MOCK_MODE=1
# Android emulator + mock checkout (loads http://10.0.2.2:8000/... instead of checkout.chapa.co):
# CHAPA_MOCK_MODE=1
# CHAPA_PUBLIC_BASE_URL=http://10.0.2.2:8000

FIREBASE_PROJECT_ID=change-me
FIREBASE_CLIENT_EMAIL=change-me@change-me.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=change-me.appspot.com

FCM_ENABLED=1
MEDIA_STORAGE_PROVIDER=firebase

DEFAULT_DRIVER_WAIT_MINUTES=30
DEFAULT_RESTAURANT_OPENING_TIME=08:30
PRICING_CUSTOMER_BASE_FEE=50
PRICING_CUSTOMER_PER_KM_RATE=25
PRICING_CUSTOMER_SERVICE_CHARGE=10
PRICING_SALES_BASE_FEE=50
PRICING_SALES_PER_KM_RATE=10
DEFAULT_PLATFORM_FEE=10
